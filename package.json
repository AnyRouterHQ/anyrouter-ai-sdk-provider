{
  "name": "@anyr/ai-sdk-provider",
  "version": "0.1.7",
  "description": "The AnyRouter provider for the Vercel AI SDK — call every AnyRouter model through `createAnyRouter`.",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.js"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "clean": "rm -rf dist",
    "typecheck": "tsgo --noEmit",
    "test": "vitest run",
    "prepublishOnly": "tsup"
  },
  "keywords": [
    "anyrouter",
    "ai-sdk",
    "vercel-ai-sdk",
    "ai",
    "llm",
    "openai",
    "anthropic",
    "language-model",
    "provider"
  ],
  "homepage": "https://anyrouter.dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AnyRouterHQ/anyrouter-ai-sdk-provider.git"
  },
  "bugs": {
    "url": "https://github.com/AnyRouterHQ/anyrouter-ai-sdk-provider/issues"
  },
  "author": "Duyet Le",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@anyr/sdk": "^0.1.3"
  },
  "peerDependencies": {
    "@ai-sdk/provider": "^4.0.0",
    "@ai-sdk/provider-utils": "^5.0.0",
    "ai": "^7.0.0",
    "zod": "^3.25.0 || ^4.0.0"
  },
  "devDependencies": {
    "@ai-sdk/provider": "4.0.2",
    "@ai-sdk/provider-utils": "5.0.5",
    "@types/node": "^24.0.0",
    "@typescript/native-preview": "7.0.0-dev.20260707.2",
    "ai": "7.0.15",
    "tsup": "^8.5.1",
    "typescript": "^6.0.3",
    "vitest": "^5.1.0",
    "zod": "4.6.7"
  }
}
